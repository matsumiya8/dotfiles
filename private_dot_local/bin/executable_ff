#!/bin/bash

export FZF_DEFAULT_OPTS_FILE="$HOME/.config/fzfopts"
ignoredirs="$HOME/.config/ignoredirs"
index="$HOME/.cache/file_index.txt"
indexcmd="cd / && fd -a . --hidden --ignore-file '$ignoredirs' | LC_ALL=C sort -f > '$index'"
runcmd="cat $index"

[[ -f "$ignoredirs" ]] || touch "$ignoredirs"
[[ -f "$index" ]] || eval "$indexcmd"

eval "$runcmd" | fzf --prompt "Files " \
--bind "F5:execute($indexcmd)+reload($runcmd)" \
--bind "ctrl-w:execute-silent:setsid -f kitty fresh {}" \
--bind 'left-click,enter,ctrl-o:transform:echo +accept && setsid -f xdg-open {} >/dev/null 2>&1' \
--bind "right-click,ctrl-e:execute-silent:setsid -f xdg-open $(dirname {})"