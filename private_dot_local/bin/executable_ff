#!/bin/bash
[[ $(command -v fd fzf xdg-open) ]] || {
    echo "Make sure fd, fzf and xdg-utils are installed first."
    exit 1
}

IGNOREDIRS="$HOME/.config/ignoredirs"
INDEX="$HOME/.cache/file_index.txt"
INDEXCMD="cd / && fd -a . --hidden --ignore-file '$IGNOREDIRS' | LC_ALL=C sort -f > '$INDEX'"

[[ -f "$IGNOREDIRS" ]] || touch "$IGNOREDIRS"
[[ -f "$INDEX" ]] || wait $(INDEXCMD)

export FZF_DEFAULT_OPTS=" \
--bind 'change:first' \
--bind 'tab:down' \
--bind 'shift-tab:up' \
--bind 'ctrl-c:execute-silent(wl-copy {})' \
--bind 'ctrl-d:execute-silent(mpc insert {})'
--bind 'ctrl-e:execute-silent(nohup xdg-open \"\$(dirname {})\" & disown)' \
--bind 'ctrl-v:transform-query(wl-paste | sed \"s|^file://||\")' \
--bind 'ctrl-backspace:transform-query(echo)' \
--bind 'F1:transform-query(echo $HOME/)' \
--bind 'F2:transform-query(echo /storage/music/)' \
--bind 'F5:execute($INDEXCMD)+reload(cat $INDEX)' \
--color=bg+:#313244,bg:#1E1E2E,spinner:#F5E0DC,hl:#F38BA8 \
--color=fg:#CDD6F4,header:#F38BA8,info:#CBA6F7,pointer:#F5E0DC \
--color=marker:#B4BEFE,fg+:#CDD6F4,prompt:#CBA6F7,hl+:#F38BA8 \
--color=selected-bg:#45475A \
--color=border:#6C7086,label:#CDD6F4 \
--layout=reverse \
--tiebreak=index"

FILE=$(fzf < "$INDEX")
[[ ${XDG_CURRENT_DESKTOP,,} == "hyprland" ]] && hyprctl dispatch "hl.dsp.exec_cmd('xdg-open \"$FILE\"')" || xdg-open "$FILE"